      "checkConstraints": {
        "tryout_sessions_duration_positive": {
          "name": "tryout_sessions_duration_positive",
          "value": "\"tryout_sessions\".\"duration_seconds\" > 0"
        },
        "tryout_sessions_total_positive": {
          "name": "tryout_sessions_total_positive",
          "value": "\"tryout_sessions\".\"total_questions\" > 0"
        },
        "tryout_sessions_deadline_after_start": {
          "name": "tryout_sessions_deadline_after_start",
          "value": "\"tryout_sessions\".\"deadline_at\" >= \"tryout_sessions\".\"started_at\""
        },
        "tryout_sessions_paused_remaining_valid": {
          "name": "tryout_sessions_paused_remaining_valid",
          "value": "\"tryout_sessions\".\"paused_remaining_seconds\" IS NULL OR \"tryout_sessions\".\"paused_remaining_seconds\" BETWEEN 0 AND \"tryout_sessions\".\"duration_seconds\""
        },
        "tryout_sessions_score_range": {
          "name": "tryout_sessions_score_range",
          "value": "\"tryout_sessions\".\"score\" IS NULL OR \"tryout_sessions\".\"score\" BETWEEN 0 AND 100"
        },
        "tryout_sessions_finished_consistent": {
          "name": "tryout_sessions_finished_consistent",
          "value": "(\"tryout_sessions\".\"status\" = 'selesai') = (\"tryout_sessions\".\"finished_at\" IS NOT NULL)"
        },
        "tryout_sessions_result_consistent": {
          "name": "tryout_sessions_result_consistent",
          "value": "(\"tryout_sessions\".\"status\" = 'selesai') = (\"tryout_sessions\".\"score\" IS NOT NULL AND \"tryout_sessions\".\"correct_count\" IS NOT NULL AND \"tryout_sessions\".\"wrong_count\" IS NOT NULL AND \"tryout_sessions\".\"unanswered_count\" IS NOT NULL AND \"tryout_sessions\".\"used_seconds\" IS NOT NULL)"
        },
        "tryout_sessions_used_seconds_valid": {
          "name": "tryout_sessions_used_seconds_valid",
          "value": "\"tryout_sessions\".\"used_seconds\" IS NULL OR \"tryout_sessions\".\"used_seconds\" BETWEEN 0 AND \"tryout_sessions\".\"duration_seconds\""
        },
        "tryout_sessions_result_counts_valid": {
          "name": "tryout_sessions_result_counts_valid",
          "value": "\"tryout_sessions\".\"correct_count\" IS NULL OR (\"tryout_sessions\".\"correct_count\" >= 0 AND \"tryout_sessions\".\"wrong_count\" >= 0 AND \"tryout_sessions\".\"unanswered_count\" >= 0 AND \"tryout_sessions\".\"correct_count\" + \"tryout_sessions\".\"wrong_count\" + \"tryout_sessions\".\"unanswered_count\" = \"tryout_sessions\".\"total_questions\")"
        }
      },
