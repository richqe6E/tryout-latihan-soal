# Salin ke .env.local lalu sesuaikan.
# Gunakan Connection String PostgreSQL dari Supabase (Transaction/Session Pooler atau Direct Connection)
# Contoh Supabase: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Rahasia untuk endpoint cron (/api/cron/*)
CRON_SECRET=ganti-dengan-string-acak

# Rahasia acak minimal 32 karakter untuk menandatangani sesi siswa & Better Auth
BETTER_AUTH_SECRET=ganti-dengan-string-rahasia-minimal-32-karakter
# URL publik aplikasi
BETTER_AUTH_URL=http://localhost:3000
