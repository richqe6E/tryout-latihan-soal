# Salin ke .env.local lalu sesuaikan.
# Database lokal dari docker-compose.yml (docker compose up -d)
DATABASE_URL=postgres://tryout:tryout_dev@127.0.0.1:55442/tryout_yuk

# Rahasia untuk endpoint cron (/api/cron/*), dikirim sebagai header Authorization: Bearer
CRON_SECRET=ganti-dengan-string-acak

# Better Auth — rahasia acak minimal 32 karakter (mis. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=
# URL publik aplikasi (wajib di produksi), mis. https://tryoutyuk.vercel.app
BETTER_AUTH_URL=
